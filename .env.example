# JustResume AI — Root Configuration Template
# This file contains examples for all required environment variables.
# Copy this to .env in your local development environment.

# --- Backend Configuration ---
# Options: development, staging, production
APP_ENV=development
DEBUG=true
PORT=8000

# Gemini API Key (Required for resume generation)
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Configuration
# Required for user auth, profile storage, and file storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=generated-resumes

# Access control
# Default is strict: users must be active in public.allowed_users.
# Use "google" to allow any user authenticated through Supabase Google OAuth.
AUTH_ACCESS_MODE=allowlist
# Local development only: set true to allow any valid authenticated Supabase user.
ALLOW_ALL_AUTHENTICATED_USERS=false

# CORS - JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173","http://127.0.0.1:5173"]

# --- Queue / Background Jobs (optional) ---
# Redis connection used when GENERATION_EXECUTOR=worker.
# In Docker Compose, use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
# Execution mode: "in-process" (default) or "worker".
# IMPORTANT: Keep "in-process" until Phase 6D is complete.
# Setting "worker" without the worker process and real execution
# wiring will cause enqueued jobs to fail.
GENERATION_EXECUTOR=in-process
# RQ queue key name for generation jobs.
GENERATION_QUEUE_NAME=generations
# Max retry attempts for failed generation jobs.
GENERATION_MAX_RETRIES=3

# --- Generation limits ---
# Local development can use higher values while testing broken runs.
ENABLE_GENERATION_LIMITS=true
HOURLY_GENERATION_LIMIT_PER_USER=50
DAILY_GENERATION_LIMIT_PER_USER=200
MAX_ACTIVE_GENERATIONS_PER_USER=2

# --- Frontend Configuration ---
# Note: Frontend variables MUST start with VITE_
VITE_API_BASE=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth redirect URLs to add in the Supabase dashboard:
# http://localhost:3099/auth/callback
# https://your-frontend-domain.com/auth/callback
