#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# Pre-commit hook: Secret scanning & repo hygiene
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# ──────────────────────────────────────────────────────────────

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Running pre-commit security checks..."

ERRORS=0

# ── 1. Block .env files (except .env.example) ────────────────
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^[^/]*\.env$|^.*/[^/]*\.env$' | grep -v '\.env\.example' || true)
if [ -n "$ENV_FILES" ]; then
  echo -e "${RED}❌ Blocked commit: .env files detected${NC}"
  echo "   Files: $ENV_FILES"
  echo "   Use .env.example for templates. Never commit real secrets."
  ERRORS=$((ERRORS + 1))
fi

# ── 2. Block common secret patterns in staged files ──────────
SECRET_PATTERNS=(
  'AIzaSy[A-Za-z0-9_-]{35}'              # Google API keys
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'  # JWT tokens
  'sk-[A-Za-z0-9]{20,}'                   # OpenAI-style keys
  'ghp_[A-Za-z0-9]{36}'                   # GitHub personal tokens
  'xox[baprs]-[A-Za-z0-9-]{10,}'          # Slack tokens
  '-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----' # Private keys
  'sb_publishable_[A-Za-z0-9_-]{20,}'      # Supabase publishable keys
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|js|ts|tsx|jsx|json|yml|yaml|toml|env|cfg|ini|conf)$' || true)

if [ -n "$STAGED_FILES" ]; then
  for pattern in "${SECRET_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | xargs grep -lE "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}❌ Potential secret detected (pattern: $pattern)${NC}"
      echo "   Files: $MATCHES"
      ERRORS=$((ERRORS + 1))
    fi
  done
fi

# ── 3. Block __pycache__, .pyc, node_modules, dist ──────────
JUNK_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '__pycache__|\.pyc$|\.pyo$|node_modules/|dist/' || true)
if [ -n "$JUNK_FILES" ]; then
  echo -e "${RED}❌ Blocked commit: generated/cache files detected${NC}"
  echo "   Files: $JUNK_FILES"
  ERRORS=$((ERRORS + 1))
fi

# ── 4. Block private keys ───────────────────────────────────
KEY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.(pem|key|p12|pfx|jks|keystore)$' || true)
if [ -n "$KEY_FILES" ]; then
  echo -e "${RED}❌ Blocked commit: private key files detected${NC}"
  echo "   Files: $KEY_FILES"
  ERRORS=$((ERRORS + 1))
fi

# ── Result ──────────────────────────────────────────────────
if [ $ERRORS -gt 0 ]; then
  echo -e "\n${RED}❌ Pre-commit checks failed ($ERRORS issue(s)). Commit blocked.${NC}"
  echo "   To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi

echo -e "${GREEN}✅ All security checks passed.${NC}"
exit 0
