# ── Required ──────────────────────────────────────────────────────────
# Production: set to your deployed backend, e.g. https://your-app.onrender.com/api/v1
# Local:      http://localhost:8000/api/v1
VITE_API_BASE=http://localhost:8000/api/v1

# Supabase project URL from Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key from Supabase Project Settings > API
# NEVER put the service-role key in any VITE_* variable.
VITE_SUPABASE_ANON_KEY=

# ── Optional ─────────────────────────────────────────────────────────
# VITE_APP_ENV=production
# VITE_APP_VERSION=0.1.0
