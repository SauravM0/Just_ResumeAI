# ─── App Environment ──────────────────────────────────────────────────
# Options: development, staging, production
APP_ENV=development
# Set to "false" in production, "true" in development to enable hot-reload
DEBUG=true

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated or JSON array of allowed origins
# Examples:
#   CORS_ORIGINS=http://localhost:5173
#   CORS_ORIGINS=["https://app.example.com","https://staging.example.com"]
CORS_ORIGINS=http://localhost:5173

# ─── Gemini AI ────────────────────────────────────────────────────────
# Required for resume generation and ATS scoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-pro

# ─── Supabase ──────────────────────────────────────────────────────────
# Required for user auth, profile storage, history, and file storage
# Project URL from Supabase Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# JWT Secret from Supabase Project Settings > API > JWT Settings.
# This is NOT the anon key and NOT the service-role key.
SUPABASE_JWT_SECRET=
# Backend-only service role key from Supabase Project Settings > API.
# Never expose this value to Vite, React, browser code, or client logs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=generated-resumes

# ─── Generated Files ──────────────────────────────────────────────────
# Number of days before generated PDF/DOCX files expire
FILE_EXPIRY_DAYS=7

# ─── Path Overrides ─────────────────────────────────────────────────
# These can be left as defaults in most deployments.
# Override if your container has a different filesystem layout.
# LATEX_OUTPUT_DIR=output
# LATEX_TEMPLATE_DIR=templates/latex

# ─── Render / Railway Production Example ──────────────────────────────
# APP_ENV=production
# DEBUG=false
# PORT=8000
# CORS_ORIGINS=https://your-frontend.vercel.app
# LATEX_OUTPUT_DIR=/app/output
