# ── JustResume AI — Backend Configuration ──────────────────────────────
# Copy this file to .env and fill in real values.

# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development                     # development | production
DEBUG=true
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173","http://127.0.0.1:5173"]

# ── Gemini AI (Required for generation & scoring) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_TOKENS=8192
GEMINI_MAX_RETRIES=3
GEMINI_TEMPERATURE=0.3

# ── Supabase (Required for DB, Auth & Storage) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=generated-resumes

# Access control
# Default is strict: users must be active in public.allowed_users.
# Local development only. This is rejected when APP_ENV=production.
ALLOW_ALL_AUTHENTICATED_USERS=false

# ── RAG / Embeddings ──────────────────────────────────────────────────
ENABLE_RAG_EMBEDDINGS=true
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMS=768
SIMILARITY_THRESHOLD=0.55

# ── Feature Flags ─────────────────────────────────────────────────────
ENABLE_JD_CACHE=true
ENABLE_RECRUITER_REVIEW=true

# ── Caching ───────────────────────────────────────────────────────────
JD_CACHE_TTL_HOURS=24

# ── Rate Limiting ────────────────────────────────────────────────────
MAX_GENERATION_REQUESTS_PER_HOUR=5
MAX_JD_ANALYSIS_REQUESTS_PER_HOUR=15
MAX_REQUEST_BODY_SIZE_KB=512
ENABLE_GENERATION_LIMITS=true
HOURLY_GENERATION_LIMIT_PER_USER=50
DAILY_GENERATION_LIMIT_PER_USER=200
MAX_ACTIVE_GENERATIONS_PER_USER=2

# ── SSE Streaming ─────────────────────────────────────────────────────
SSE_KEEPALIVE_INTERVAL=15

# ── Generated Files ──────────────────────────────────────────────────
FILE_EXPIRY_DAYS=7

# ── LaTeX ─────────────────────────────────────────────────────────────
LATEX_EXTRACTION_CALIBRATION=4.0
# LATEX_OUTPUT_DIR=output
# LATEX_TEMPLATE_DIR=templates/latex

# ── Queue / Background Jobs (optional) ────────────────────────────────
# Redis connection used when GENERATION_EXECUTOR=worker.
# In Docker Compose, use redis://redis:6379/0 (the redis service hostname).
REDIS_URL=redis://localhost:6379/0
# Execution mode: "in-process" (default) or "worker".
# IMPORTANT: Keep "in-process" until Phase 6D is complete.
# Setting "worker" without the worker process running and the real
# generation execution wired will cause enqueued jobs to fail.
GENERATION_EXECUTOR=in-process
# RQ queue key name for generation jobs.
GENERATION_QUEUE_NAME=generations
# Max retry attempts for failed generation jobs.
GENERATION_MAX_RETRIES=3
